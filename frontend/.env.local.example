# ============================================
# Frontend Environment Variables (Phase 1)
# ============================================
# Copy to `.env.local` and fill in real values.
# Never commit `.env.local` (only this `.example`).
#
# WARNING: Anything prefixed with NEXT_PUBLIC_ is shipped to the browser.
# Never put GOOGLE_API_KEY or SUPABASE_SERVICE_ROLE_KEY here.

# ---- Supabase (public keys only) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# ---- Backend API URL ----
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Prod example: NEXT_PUBLIC_API_URL=https://api.yourapp.com
