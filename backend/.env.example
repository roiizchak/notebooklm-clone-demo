# ============================================
# Backend Environment Variables (Phase 1)
# ============================================
# Copy to `.env` and fill in real values.
# Never commit `.env` (only `.env.example`).

# ---- Supabase ----
# Find at: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ---- Gemini ----
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# ---- App ----
APP_NAME=NotebookLM Reimagined
# DEBUG must stay false in production: FastAPI debug mode leaks full tracebacks to clients.
DEBUG=false

# ---- CORS ----
# Comma-separated list of allowed origins.
# Local dev:
CORS_ORIGINS=http://localhost:3000
# Prod example: CORS_ORIGINS=https://yourapp.com,https://www.yourapp.com
